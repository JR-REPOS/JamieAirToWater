diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
new file mode 100644
index 0000000..9190d35
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,41 @@
+# Deploys the production site to GitHub Pages by publishing the repo
+# content to the root of the gh-pages branch.
+name: Deploy site to GitHub Pages
+
+on:
+  push:
+    branches: ["main"]
+
+  # Allow running manually from the Actions tab
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+# One deployment at a time; let in-progress production deployments finish.
+concurrency:
+  group: "pages"
+  cancel-in-progress: false
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Assemble site
+        run: |
+          mkdir _site
+          rsync -a --exclude '.git' --exclude '.github' --exclude '_site' ./ _site/
+
+      - name: Publish to gh-pages branch
+        uses: JamesIves/github-pages-deploy-action@v4
+        with:
+          branch: gh-pages
+          folder: _site
+          clean: true
+          # Never delete the PR previews that live in pr-preview/
+          clean-exclude: |
+            pr-preview
+            pr-preview/**
diff --git a/.github/workflows/preview.yml b/.github/workflows/preview.yml
new file mode 100644
index 0000000..8906275
--- /dev/null
+++ b/.github/workflows/preview.yml
@@ -0,0 +1,43 @@
+# Deploys a preview of every pull request to GitHub Pages at:
+#   https://jayreddin.github.io/JamieAirToWater/pr-preview/pr-<number>/
+# and leaves a sticky comment on the PR with the link. The preview is
+# removed automatically when the PR is closed.
+# Note: PRs from forks are not supported by rossjrw/pr-preview-action v1.
+name: Deploy PR preview
+
+on:
+  pull_request:
+    types:
+      - opened
+      - reopened
+      - synchronize
+      - closed
+
+permissions:
+  contents: write        # push the preview to the gh-pages branch
+  pull-requests: write   # post the preview-link comment on the PR
+
+concurrency: preview-${{ github.ref }}
+
+jobs:
+  deploy-preview:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        if: github.event.action != 'closed'
+        uses: actions/checkout@v4
+
+      - name: Assemble site
+        if: github.event.action != 'closed'
+        run: |
+          mkdir _site
+          rsync -a --exclude '.git' --exclude '.github' --exclude '_site' ./ _site/
+
+      - name: Deploy preview
+        uses: rossjrw/pr-preview-action@v1
+        with:
+          source-dir: ./_site
+          preview-branch: gh-pages
+          umbrella-dir: pr-preview
+          # Don't use the third-party QR code service in the PR comment
+          qr-code: false
